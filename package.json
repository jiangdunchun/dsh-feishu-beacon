{
  "name": "dsh-feishu-beacon",
  "version": "0.3.0",
  "description": "DSH plugin that pushes agent progress and human-attention events to a Feishu (Lark) custom-bot webhook",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "feishu",
    "lark",
    "notifications"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "dsh-feishu-beacon contributors",
  "engines": {
    "node": ">=20.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangdunchun/dsh-feishu-beacon.git"
  },
  "bugs": {
    "url": "https://github.com/jiangdunchun/dsh-feishu-beacon/issues"
  },
  "homepage": "https://github.com/jiangdunchun/dsh-feishu-beacon#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/no-cjk.mjs && node test/smoke.mjs && node test/client-smoke.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test:profile": "node test/profile-check.mjs",
    "test:packing": "node test/pack-install-check.mjs",
    "test:installed": "node test/install-load.mjs",
    "test:cordis": "node test/cordis-mount.mjs",
    "test:live": "node test/live-contract.mjs"
  },
  "//devDependencies": "Test-time resolution set only. The host half imports @deepseek-ai/dsh-tools and @deepseek-ai/schemastery; a dsh profile supplies them at runtime from the installation, and these copies are what the checkout's own tests resolve against. They are pinned to the dsh release this plugin was verified against: dsh is a developer preview with breaking changes between releases.",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
